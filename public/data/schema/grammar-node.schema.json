{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-words.local/schema/grammar-node.schema.json",
  "title": "GrammarNode",
  "description": "영어 문법 커리큘럼의 단일 학습 노드 계약",
  "type": "object",
  "required": [
    "id",
    "level",
    "title",
    "prerequisite",
    "difficultyTag",
    "canDo",
    "summary",
    "patterns",
    "examples",
    "errorCodes",
    "masteryRule"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(A1|A2|B1|B2|C1)-G\\d{2}$"
    },
    "level": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "prerequisite": {
      "type": ["string", "null"],
      "pattern": "^(A1|A2|B1|B2|C1)-G\\d{2}$"
    },
    "difficultyTag": {
      "type": "string",
      "enum": ["core", "expansion", "integration", "complex", "precision"]
    },
    "canDo": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errorCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "masteryRule": {
      "type": "object",
      "required": ["quizAccuracy", "productionPass", "errorTolerance"],
      "properties": {
        "quizAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "productionPass": {
          "type": "boolean"
        },
        "errorTolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
