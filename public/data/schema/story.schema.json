{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-words.local/schema/story.schema.json",
  "title": "StoryContent",
  "description": "한 학습 레벨의 6개 챕터 소설 본문과 본문 내 단어·구동사 결합 계약",
  "type": "object",
  "required": [
    "schemaVersion",
    "level",
    "title",
    "chapterTitles",
    "isManual",
    "coverage",
    "usedWords",
    "usedPhrasalVerbs",
    "storyText"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "\\S"
    },
    "level": {
      "type": "string",
      "enum": ["기초", "유치원", "초등학교", "중학교"]
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "chapterTitles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "isManual": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "required": [
        "mustCoverAll",
        "allowUpperLevelWords",
        "coverageRate",
        "phrasalVerbCoverageRate"
      ],
      "properties": {
        "mustCoverAll": {
          "type": "boolean"
        },
        "allowUpperLevelWords": {
          "const": false
        },
        "coverageRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "phrasalVerbCoverageRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "usedWords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lemma", "partOfSpeech", "forms"],
        "properties": {
          "lemma": {
            "type": "string",
            "pattern": "\\S"
          },
          "partOfSpeech": {
            "type": "string",
            "pattern": "\\S"
          },
          "forms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "usedPhrasalVerbs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phrasalVerb", "storyForm", "context", "senseId", "meaningKo"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "phrasalVerb": {
            "type": "string",
            "pattern": "\\S"
          },
          "storyForm": {
            "type": "string",
            "pattern": "\\S"
          },
          "context": {
            "type": "string",
            "pattern": "\\S"
          },
          "senseId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "meaningKo": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "storyText": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "additionalProperties": false
}
