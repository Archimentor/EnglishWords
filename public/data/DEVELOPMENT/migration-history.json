    },
    {
      "from": 3,
      "to": 5,
      "strategy": "preserve-compatible-state; initialize-level-analytics"
    },
    {
      "from": 4,
      "to": 5,
      "strategy": "move-global-difficulty-and-study-analytics-into-the-current-level"
    },
    {
      "from": 5,
      "to": 6,
      "strategy": "preserve-learning-state-and-initialize-tracking-v2"
    },
    {
      "from": "6-tracking-v1",
