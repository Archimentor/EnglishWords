{
  "name": "english-words-master",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "verify:offline": "tsx scripts/verify-offline.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "validate:data": "tsx scripts/validate-data.ts --mode=development",
    "validate:reader-story": "tsx scripts/validate-reader-story.ts",
    "validate:release": "tsx scripts/validate-data.ts --mode=release && npm run validate:reader-story",
    "content:fetch": "tsx scripts/content/fetchSources.ts",
    "content:fetch:phrasals": "tsx scripts/content/fetchPhrasalSources.ts",
    "content:report": "tsx scripts/content/reportSources.ts",
    "content:validate:families": "python scripts/content/validate_word_family_registry.py",
    "content:prepare:phrasals": "tsx scripts/content/preparePhrasalTranslation.ts",
    "content:propose:phrasals": "python scripts/content/translate_phrasal_glosses.py",
    "content:approve:stories": "tsx scripts/content/approveStoryDrafts.ts",
    "content:build": "tsx scripts/content/buildContent.ts",
    "check": "npm run validate:data && npm run validate:reader-story && npm run lint && npm test && npm run build && npm run verify:offline"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/unbzip2-stream": "1.4.3",
    "@vitejs/plugin-react": "6.0.5",
    "compromise": "14.16.0",
    "eslint": "10.0.0",
    "eslint-plugin-react-hooks": "6.9.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "unbzip2-stream": "1.4.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wink-pos-tagger": "2.2.2"
  }
}
