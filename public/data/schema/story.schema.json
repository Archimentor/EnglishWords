{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-words.local/schema/story.schema.json",
  "title": "StoryContent",
  "description": "한 학습 레벨의 서사형 본편과 일반 단어·구동사 전체 확장 장면 콘텐츠 계약",
  "type": "object",
  "required": [
    "schemaVersion",
    "level",
    "title",
    "isManual",
    "coverage",
    "usedWords",
    "usedPhrasalVerbs",
    "storyText",
    "vocabularyPracticeText",
    "phrasalVerbPracticeText"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "\\S"
    },
    "level": {
      "type": "string",
      "enum": ["기초", "유치원", "초등학교", "중학교"]
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "isManual": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "required": ["mustCoverAll", "allowUpperLevelWords", "coverageRate"],
      "properties": {
        "mustCoverAll": {
          "type": "boolean"
        },
        "allowUpperLevelWords": {
          "type": "boolean"
        },
        "coverageRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "usedWords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lemma", "partOfSpeech", "forms"],
        "properties": {
          "lemma": {
            "type": "string",
            "pattern": "\\S"
          },
          "partOfSpeech": {
            "type": "string",
            "pattern": "\\S"
          },
          "forms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "usedPhrasalVerbs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phrasalVerb", "example"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "phrasalVerb": {
            "type": "string",
            "pattern": "\\S"
          },
          "example": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "storyText": {
      "type": "string",
      "pattern": "\\S"
    },
    "vocabularyPracticeText": {
      "type": "string",
      "pattern": "\\S"
    },
    "phrasalVerbPracticeText": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "additionalProperties": false
}
